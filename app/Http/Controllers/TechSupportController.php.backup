    /**
     * Obtener problemas por categoría dinámicamente
     */
    private function getProblemsByCategoryDynamic($category)
    {
        $categoryModel = TechSupportCategory::where('name', $category)->first();
        
        if (!$categoryModel) {
            return [];
        }

        $problems = $categoryModel->problems()->get();
        
        return $problems->map(function ($problem) {
            return [
                'id' => $problem->problem_key,
                'title' => $problem->title,
                'description' => $problem->description
            ];
        })->toArray();
        
        return $problems->map(function ($problem) {
            return [
                'id' => $problem->problem_key,
                'title' => $problem->title,
                'description' => $problem->description
            ];
        })->toArray();
    }

    /**
     * Manejar selección de problema específico
     */
    private function selectProblem($problemId, $sessionId)
    {
        $solution = $this->getSolutionForProblem($problemId);
        
        // Determinar categoría del problema
        $category = 'other';
        if (str_starts_with($problemId, 'computadora_')) $category = 'computer';
        elseif (str_starts_with($problemId, 'internet_')) $category = 'internet';
        elseif (str_starts_with($problemId, 'correo_')) $category = 'email';
        elseif (str_starts_with($problemId, 'impresora_')) $category = 'printer';
        elseif (str_starts_with($problemId, 'software_')) $category = 'software';
        elseif (str_starts_with($problemId, 'acceso_')) $category = 'access';
        
        // Guardar en la base de datos
        TechSupportConversation::create([
            'session_id' => $sessionId,
            'user_message' => "Problema específico: {$problemId}",
            'problem_category' => $category,
            'problem_type' => $problemId,
            'bot_response' => $solution['content'],
            'context_data' => json_encode([
                'action' => 'problem_selected',
                'problem_id' => $problemId,
                'timestamp' => now()
            ]),
            'user_ip' => request()->ip(),
            'user_agent' => request()->userAgent()
        ]);

        return response()->json([
            'problem_id' => $problemId,
            'solution' => $solution,
            'session_id' => $sessionId
        ]);
    }

    /**
     * Obtener solución para un problema específico
     */
    private function getSolutionForProblem($problemId)
    {
        $problem = TechSupportProblem::where('problem_key', $problemId)->where('is_active', true)->first();
        
        if (!$problem) {
            return [
                'title' => '❓ Problema no encontrado',
                'content' => '<div class="text-center p-6"><p class="text-gray-600">Lo siento, no pude encontrar una solución para este problema específico. Por favor, contacta al departamento de IT para obtener ayuda personalizada.</p></div>',
                'priority' => 'medium',
                'estimated_time' => 'N/A'
            ];
        }

        return [
            'title' => $problem->solution_title,
            'content' => $problem->solution_content,
            'priority' => $problem->priority,
            'estimated_time' => $problem->estimated_time
        ];
    }
