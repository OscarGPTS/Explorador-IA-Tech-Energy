    /**
     * Marcar problema como resuelto
     */
    private function markResolved($sessionId)
    {
        $conversation = TechSupportConversation::where('session_id', $sessionId)->latest()->first();
        
        if ($conversation) {
            $conversation->update(['problem_solved' => true]);
        }

        return response()->json(['success' => true, 'message' => 'Problema marcado como resuelto']);
    }

    /**
     * Escalar a IT
     */
    private function escalateToIT($sessionId, $reason = null)
    {
        $conversation = TechSupportConversation::where('session_id', $sessionId)->latest()->first();
        
        if ($conversation) {
            $conversation->update([
                'escalated_to_human' => true,
                'resolution_method' => 'escalated_to_it'
            ]);
        }

        return response()->json([
            'success' => true, 
            'message' => 'Gracias por usar el sistema de soporte técnico. Para problemas más complejos que requieran atención personalizada, por favor contacta directamente al departamento de IT.'
        ]);
    }

    /**
     * Obtener estadísticas básicas
     */
    private function getStats()
    {
        $totalConversations = TechSupportConversation::count();
        $resolvedToday = TechSupportConversation::whereDate('created_at', today())
            ->where('problem_solved', true)->count();
        $escalatedToday = TechSupportConversation::whereDate('created_at', today())
            ->where('escalated_to_human', true)->count();

        // Categorías populares de la última semana
        $categoriesPopular = TechSupportConversation::selectRaw('problem_category, COUNT(*) as count')
            ->whereDate('created_at', '>=', now()->subDays(7))
            ->whereNotNull('problem_category')
            ->groupBy('problem_category')
            ->orderByDesc('count')
            ->limit(3)
            ->get()
            ->map(function ($item) {
                return (object) [
                    'problem_category' => $item->problem_category,
                    'count' => (int) $item->count
                ];
            });

        return [
            'total_conversations' => $totalConversations,
            'resolved_today' => $resolvedToday,
            'escalated_today' => $escalatedToday,
            'categories_popular' => $categoriesPopular
        ];
    }

    /**
     * Obtener estadísticas detalladas para el dashboard
     */
    private function getDetailedStats()
    {
        $baseStats = TechSupportConversation::getSolutionEffectiveness();
        
        // Obtener estadísticas por categoría con formato consistente
        $categoryStats = TechSupportConversation::selectRaw('
            problem_category,
            COUNT(*) as total,
            SUM(CASE WHEN problem_solved = 1 THEN 1 ELSE 0 END) as resolved,
            SUM(CASE WHEN escalated_to_human = 1 THEN 1 ELSE 0 END) as escalated
        ')
        ->whereDate('created_at', '>=', now()->subDays(30))
        ->whereNotNull('problem_category')
        ->groupBy('problem_category')
        ->get()
        ->map(function ($item) {
            return (object) [
                'problem_category' => $item->problem_category,
                'total' => (int) $item->total,
                'resolved' => (int) $item->resolved,
                'escalated' => (int) $item->escalated
            ];
        });

        // Obtener problemas populares
        $popularProblems = TechSupportConversation::selectRaw('
            problem_type,
            problem_category,
            COUNT(*) as count
        ')
        ->whereDate('created_at', '>=', now()->subDays(30))
        ->whereNotNull('problem_type')
        ->groupBy('problem_type', 'problem_category')
        ->orderByDesc('count')
        ->limit(10)
        ->get()
        ->map(function ($item) {
            return (object) [
                'problem_type' => $item->problem_type,
                'problem_category' => $item->problem_category,
                'count' => (int) $item->count
            ];
        });

        // Estadísticas diarias
        $dailyStats = TechSupportConversation::selectRaw('
            DATE(created_at) as date, 
            COUNT(*) as count
        ')
        ->whereDate('created_at', '>=', now()->subDays(7))
        ->groupBy('date')
        ->orderBy('date')
        ->get()
        ->map(function ($item) {
            return (object) [
                'date' => $item->date,
                'count' => (int) $item->count
            ];
        });

        // Distribución horaria
        $hourlyDistribution = TechSupportConversation::selectRaw('
            HOUR(created_at) as hour, 
            COUNT(*) as count
        ')
        ->whereDate('created_at', '>=', now()->subDays(7))
        ->groupBy('hour')
        ->orderBy('hour')
        ->get()
        ->map(function ($item) {
            return (object) [
                'hour' => (int) $item->hour,
                'count' => (int) $item->count
            ];
        });

        return array_merge($baseStats ?? [], [
            'category_stats' => $categoryStats,
            'popular_problems' => $popularProblems,
            'daily_stats' => $dailyStats,
            'hourly_distribution' => $hourlyDistribution
        ]);
    }

    /**
     * Mapear categoría a enum de la base de datos
     */
    private function mapCategoryToEnum($category)
    {
        $mapping = [
            'computadora' => 'computer',
            'internet' => 'internet',
            'correo' => 'email',
            'impresora' => 'printer',
            'software' => 'software',
            'acceso' => 'access'
        ];
        
        return $mapping[$category] ?? 'other';
    }
}
